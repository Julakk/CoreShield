# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# Nginx integration
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_RELOAD_CMD=systemctl reload nginx

# CrowdSec / iptables integration
CROWDSEC_BOUNCER_API=http://127.0.0.1:8080
CROWDSEC_BOUNCER_API_KEY=replace_with_bouncer_key
BLOCK_METHOD=crowdsec
# BLOCK_METHOD can be "crowdsec" or "iptables"

# Only used when BLOCK_METHOD=iptables. Must match the path granted in your
# sudoers rule (see scripts/coreshield-sudoers.example).
FIREWALL_SCRIPT_PATH=/opt/coreshield/scripts/manage_firewall.sh
FIREWALL_SUDO_BIN=sudo

# Allowed CORS origin(s), comma separated
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
NGINX_SNIPPETS_DIR=/etc/nginx/coreshield-snippets
